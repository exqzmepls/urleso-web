<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" @ref="@_mudThemeProvider" Theme="MyTheme"/>

@code {

    private bool _isDarkMode;
    private MudThemeProvider _mudThemeProvider = null!;

    public static MudTheme MyTheme => new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = Colors.Blue.Default,
            Secondary = Colors.Gray.Lighten1
        },
        PaletteDark = new PaletteDark
        {
            Primary = Colors.LightGreen.Darken3,
            Secondary = Colors.Gray.Default
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The provider only starts watching for system changes on its first render; the initial
        // value still has to be read once. Subsequent changes flow back through @bind-IsDarkMode.
        if (firstRender)
        {
            _isDarkMode = await _mudThemeProvider.GetSystemDarkModeAsync();
            StateHasChanged();
        }
    }

}
